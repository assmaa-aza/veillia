# --- Supabase -----------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-or-anon-key
SUPABASE_TABLE=articles

# --- Ollama (local LLM) --------------------------------------------------
# Any model you have pulled locally works: llama3.2, qwen2.5, mistral, etc.
# Use 127.0.0.1 rather than "localhost": on some systems (notably Windows)
# "localhost" resolves to the IPv6 address ::1 first, and if Ollama isn't
# listening on IPv6 the request just hangs until it times out -- which
# looks exactly like a slow model rather than a network problem.
OLLAMA_URL=http://127.0.0.1:11434
# Always include an explicit tag (e.g. "qwen2.5:3b", not just "qwen2.5").
# Without a tag, Ollama may try to resolve/pull "<model>:latest" in the
# middle of a generation call, which can look like a long timeout.
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_RETRIES=3
OLLAMA_RETRY_BACKOFF_SECONDS=2.0
# Keeps the model loaded in RAM between requests -- avoids slow reloads on
# machines with limited memory. "5m" = 5 minutes, "-1" = keep forever.
OLLAMA_KEEP_ALIVE=5m

# --- Summarization rules ---------------------------------------------------
# Short, scannable teaser (2-3 sentences) -- depth lives in the separate
# structured analysis (see ANALYSIS_* below / analysis_main.py), not here.
SUMMARY_MIN_WORDS=30
SUMMARY_MAX_WORDS=60
SUMMARY_LANGUAGE=en
BATCH_SIZE=10
# Chunked summarization (split article -> summarize each part -> merge).
# Keeps each LLM call small -- faster and lighter on RAM than one big
# prompt for the whole article. Recommended on memory-constrained machines.
SUMMARY_USE_CHUNKING=true
SUMMARY_NUM_CHUNKS=3
# Articles shorter than this are summarized in one pass regardless of the
# setting above -- not worth splitting a short article into thirds.
SUMMARY_CHUNKING_MIN_CHARS=600

# --- Classification rules --------------------------------------------------
CLASSIFICATION_BATCH_SIZE=20
CLASSIFICATION_MAX_CONTENT_CHARS=3000
# Chunked classification (split article -> classify each part -> majority
# vote). Keeps each call small -- avoids the timeouts a long single-prompt
# classification can cause on memory-constrained machines.
CLASSIFICATION_USE_CHUNKING=true
CLASSIFICATION_NUM_CHUNKS=3
CLASSIFICATION_CHUNKING_MIN_CHARS=600

# --- Structured analysis rules ----------------------------------------------
ANALYSIS_BATCH_SIZE=10
ANALYSIS_MAX_CONTENT_CHARS=4000
# Deliberately low -- many scraped articles only have a short excerpt
# rather than full page text. Lower this further (even to 1) if you want
# every article attempted regardless of content length.
ANALYSIS_MIN_CONTENT_CHARS=30
ANALYSIS_MIN_SUMMARY_WORDS=8
ANALYSIS_MIN_INSIGHT_WORDS=3
# Chunked analysis (split -> extract short notes per part -> 2 lighter
# generation calls instead of 1 heavy 7-section call). This is the single
# biggest lever for avoiding timeouts on memory-constrained machines --
# a full single-call analysis is the heaviest request in the whole project.
ANALYSIS_USE_CHUNKING=true
ANALYSIS_NUM_CHUNKS=3
ANALYSIS_CHUNKING_MIN_CHARS=800

# --- Article AI Chat API ----------------------------------------------------
CHAT_HOST=0.0.0.0
CHAT_PORT=8000
# How much raw article content to include as chat context when NO stored
# analysis exists yet.
CHAT_MAX_CONTENT_CHARS=3000
# Much smaller budget used once a stored `analysis` DOES exist -- the
# analysis already distills the article, so the raw excerpt is only a
# minor supplement. Keeps chat requests small/fast on already-analyzed articles.
CHAT_MAX_CONTENT_CHARS_WITH_ANALYSIS=800
# How many prior conversation turns to replay to the model each request --
# bounds prompt growth (and therefore latency) in long conversations.
CHAT_MAX_HISTORY_TURNS=12

# --- Logging --------------------------------------------------------------
LOG_LEVEL=INFO
