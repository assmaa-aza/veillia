# Copy this file to `.env` and fill in your Supabase credentials.
#
# By default this pipeline writes to Supabase:
#     Collector -> Normalize -> Supabase
#
# SUPABASE_URL and SUPABASE_KEY are REQUIRED unless you set
# STORAGE_BACKEND=json (see below) for local testing without a
# Supabase project.

# --------------------------------------------------------------------
# Storage backend
# --------------------------------------------------------------------

# "supabase" (default) or "json". Set to "json" to write to a local
# output/articles.json file instead -- useful for quick local testing
# without a Supabase project on hand.
STORAGE_BACKEND=supabase

# Your Supabase project URL (Dashboard -> Settings -> API -> Project URL).
SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase API key (Dashboard -> Settings -> API).
# Use the service_role key for this trusted, server-side pipeline, or
# the anon key if you've configured Row Level Security policies that
# permit inserts/upserts.
SUPABASE_KEY=your-service-role-or-anon-key

# Table name the pipeline writes to. Create it first by running
# storage/schema.sql in the Supabase SQL Editor.
SUPABASE_TABLE=articles

# Name of the local output file (relative to output/), only used when
# STORAGE_BACKEND=json.
OUTPUT_FILENAME=articles.json

# --------------------------------------------------------------------
# HTTP behaviour
# --------------------------------------------------------------------

# HTTP request timeout (in seconds) when fetching feeds/pages.
REQUEST_TIMEOUT_SECONDS=15

# User-Agent header sent with every HTTP request. Some sites are more
# permissive with a descriptive, contactable User-Agent.
USER_AGENT=VeillIA-NewsCollector/0.1 (+https://veillia.example.com; contact: dev@veillia.example.com)

# Maximum number of articles pulled per source, per run.
MAX_ARTICLES_PER_SOURCE=20

# --------------------------------------------------------------------
# Full-content fetching
# --------------------------------------------------------------------

# RSS feeds usually only expose a short excerpt, not the full article.
# When true (default), each collector visits the article's actual page
# and extracts the real body text -- one extra HTTP request per
# article, so a full run is noticeably slower with this on. Set to
# false to skip it and rely on feed-provided content only.
FETCH_FULL_CONTENT=true

# Safety cap on extracted article length (characters). 0 disables the cap.
FULL_CONTENT_MAX_CHARS=20000
